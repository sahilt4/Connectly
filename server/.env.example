# Application Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# JWT Configuration
JWT_SECRET=your_super_secret_random_jwt_key_here
JWT_EXPIRE=30d

# MongoDB Database URI (Required in Production, e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/communication_app?retryWrites=true&w=majority

# Optional SMTP Email Configuration (If left blank, verification links are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Connectly" <noreply@connectly.app>
